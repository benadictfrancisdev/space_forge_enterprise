DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
DJANGO_SETTINGS_MODULE=config.settings.local

DATABASE_URL=postgres://spaceforge:spaceforge@localhost:5432/spaceforge
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Auth: set AUTH_MODE=dev for local tests without Firebase
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=
JWT_SIGNING_KEY=dev-jwt-signing-key-spaceforge-phase01-change-me
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600

# Optional dedicated Fernet material for credential blobs (defaults to DJANGO_SECRET_KEY)
# CREDENTIAL_ENCRYPTION_KEY=

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=spaceforge
S3_SECRET_KEY=spaceforgesecret
S3_BUCKET=spaceforge
S3_REGION=us-east-1
S3_USE_SSL=false

# Upload limits (bytes)
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
FILE_UPLOAD_MAX_MEMORY_SIZE=26214400

READY_REQUIRE_WORKER=false
LOG_LEVEL=INFO
LOG_FORMAT=console

# Track 5 AI compute
AI_SERVICE_MODE=inline
AI_SERVICE_URL=http://localhost:8100
AI_SERVICE_TIMEOUT_SECONDS=60
# Optional provider keys — never commit real values
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
AI_PROVIDER_ORDER=heuristic
